{
  "name": "dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:monitoring": "vite --config vite.monitoring.config.js",
    "build": "set NODE_OPTIONS=--max-old-space-size=8192 && vite build",
    "build:monitoring": "set NODE_OPTIONS=--max-old-space-size=8192 && vite build --config vite.monitoring.config.js",
    "deploy": "set NODE_OPTIONS=--max-old-space-size=8192 && vite build && firebase deploy --only hosting:main",
    "deploy:monitoring": "npm run build:monitoring && firebase deploy --only hosting:monitoring",
    "preview": "vite preview",
    "build:app": "set NODE_OPTIONS=--max-old-space-size=8192 && set CAPACITOR_BUILD=1 && vite build",
    "cap:sync": "npm run build:app && npx cap sync",
    "cap:android": "npm run build:app && npx cap sync android && npx cap open android",
    "cap:run": "npm run build:app && npx cap run android",
    "cap:release": "npm run build:app && npx cap sync android && android\\gradlew.bat -p android assembleRelease"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^6.3.1",
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.3",
    "@capacitor/camera": "^6.1.3",
    "@capacitor/core": "^6.2.1",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/geolocation": "^6.1.1",
    "@capacitor/ios": "^6.2.1",
    "@capacitor/network": "^6.0.4",
    "@capacitor/preferences": "^6.0.4",
    "@capacitor/splash-screen": "^6.0.4",
    "@capacitor/status-bar": "^6.0.3",
    "@codetrix-studio/capacitor-google-auth": "^3.3.6",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google-cloud/vision": "^5.3.5",
    "@react-google-maps/api": "^2.20.8",
    "@react-pdf/renderer": "^4.5.1",
    "@tiptap/extension-color": "^3.23.6",
    "@tiptap/extension-highlight": "^3.23.6",
    "@tiptap/extension-text-align": "^3.23.6",
    "@tiptap/pm": "^3.23.6",
    "@tiptap/react": "^3.23.6",
    "@tiptap/starter-kit": "^3.23.6",
    "browser-image-compression": "^2.0.2",
    "chart.js": "^4.5.1",
    "cors": "^2.8.6",
    "dexie": "^4.4.3",
    "docx": "^9.6.1",
    "dom-to-image-more": "^3.10.0",
    "dompurify": "^3.4.7",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "firebase": "^12.10.0",
    "firebase-admin": "^13.8.0",
    "firebase-functions": "^7.2.5",
    "framer-motion": "^12.38.0",
    "google-map-react": "^2.2.5",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.577.0",
    "mammoth": "^1.12.0",
    "multer": "^2.1.1",
    "pdfjs-dist": "^5.6.205",
    "react": "^19.2.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.0",
    "react-is": "^19.2.7",
    "react-native-webview": "^13.16.1",
    "react-router-dom": "^7.13.1",
