PORT=8787

# MinIO
MINIO_ENDPOINT=https://storage.pt-adytia.com
MINIO_REGION=us-east-1
MINIO_BUCKET=adytia-app
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Origin frontend yang boleh manggil API ini (pisah koma, tanpa spasi ekstra)
ALLOWED_ORIGINS=https://pt-adytia.com,https://adytia-pt.web.app,https://localhost

# Service account Firebase Admin SDK (Project Settings -> Service Accounts -> Generate new private key)
# Simpan file JSON-nya DI LUAR folder ini, chmod 600, JANGAN commit ke git.
GOOGLE_APPLICATION_CREDENTIALS=/etc/adytia/service-account.json
